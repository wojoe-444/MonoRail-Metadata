# Copy to .env and fill in. The server reads it on start (server/config.ts).

# ---- OpenMetadata ----
# Leave OM_URL empty to run on the built-in demo catalog.
OM_URL=
# A bot JWT from OpenMetadata (Settings > Bots > ingestion-bot, or a bot made for this app). Preferred.
OM_TOKEN=
# Or a basic-auth login. The docker default is admin@open-metadata.org / admin.
OM_EMAIL=
OM_PASSWORD=
# The OpenMetadata database service that holds the BigQuery catalog.
OM_BIGQUERY_SERVICE=bigquery

# ---- BigQuery (for running Malloy queries) ----
# Credentials come from Application Default Credentials (`gcloud auth application-default login`)
# or a service account key file in GOOGLE_APPLICATION_CREDENTIALS.
BQ_PROJECT_ID=
BQ_BILLING_PROJECT_ID=
BQ_LOCATION=US
# Per-query cap, in bytes (default 10 GB). Queries over it fail instead of billing.
BQ_MAX_BYTES_BILLED=10737418240
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# ---- Malloy ----
MALLOY_DIR=malloy
MALLOY_ROW_LIMIT=5000

# ---- Server ----
PORT=8787
