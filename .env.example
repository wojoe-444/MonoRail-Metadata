# Copy to .env and fill in. The server reads it on start (server/config.ts).

# ---- OpenMetadata ----
# Leave OM_URL empty to run on the built-in demo catalog.
OM_URL=
# A bot JWT from OpenMetadata (Settings > Bots > ingestion-bot, or a bot made for this app). Preferred.
OM_TOKEN=
# Or a basic-auth login. The docker default is admin@open-metadata.org / admin.
OM_EMAIL=
OM_PASSWORD=
# The OpenMetadata database service that holds the BigQuery catalog.
OM_BIGQUERY_SERVICE=bigquery

# ---- BigQuery (for running Malloy queries) ----
# Credentials come from Application Default Credentials (`gcloud auth application-default login`)
# or a service account key file in GOOGLE_APPLICATION_CREDENTIALS.
BQ_PROJECT_ID=
BQ_BILLING_PROJECT_ID=
BQ_LOCATION=US
# Per-query cap, in bytes (default 10 GB). Queries over it fail instead of billing.
BQ_MAX_BYTES_BILLED=10737418240
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# ---- Malloy ----
MALLOY_DIR=malloy
MALLOY_ROW_LIMIT=5000

# ---- Server ----
PORT=8787

# ---- Team backend: the worker (worker/, docs/team-backend.md) ----
# Run it with `npm run worker`. It reads OM_URL and OM_TOKEN (or OM_EMAIL/OM_PASSWORD) above:
# in team mode the worker is the only client of OpenMetadata.
# The shared bucket: gs://bucket/prefix, or a local folder. Default: .team-bucket/ at the repo root.
TEAM_BUCKET=
# How requests prove who sent them: local (a typed name; one machine, development) or google (a verified ID token).
TEAM_AUTH=local
# Who the `npm run team:echo` CLI says it is with TEAM_AUTH=local.
TEAM_USER=admin
# The Google OAuth client ID that ID tokens must be issued for (TEAM_AUTH=google).
GOOGLE_OAUTH_CLIENT_ID=
# Who may send requests with TEAM_AUTH=google: email domains and/or single addresses, comma-separated.
# With both empty, every Google identity is refused.
TEAM_ALLOWED_DOMAINS=
TEAM_ALLOWED_EMAILS=
# Rebuild the catalog snapshot this often if anything changed, in minutes. Also how quickly lineage edits made
# outside the queue reach apps (OpenMetadata 2.0.8 has no change events for lineage).
TEAM_SNAPSHOT_MINUTES=30
# Check OpenMetadata's change events (edits made outside the queue) this often, in seconds.
TEAM_OM_EVENTS_SECONDS=30
# A request still waiting after this many minutes is answered "expired" instead of being applied.
TEAM_REQUEST_TTL_MINUTES=60
# Optional BigQuery audit trail: dataset (or project.dataset) for the metadata_events table. Empty: off.
TEAM_BQ_DATASET=
# How often the worker lists the inbox, in seconds (each listing is one bucket operation).
TEAM_POLL_SECONDS=1
