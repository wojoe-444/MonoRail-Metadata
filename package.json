{
  "name": "monorail-metadata",
  "version": "0.1.0",
  "description": "Metadata platform on headless OpenMetadata, with Malloy, in the MonoRail UI",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node --watch --import tsx server/index.ts\"",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "ui:add": "node scripts/add-ui.mjs",
    "seed:om": "tsx scripts/seed-openmetadata.ts",
    "dev:web": "vite",
    "dev:api": "node --watch --import tsx server/index.ts",
    "start": "tsx server/index.ts",
    "pilot": "node scripts/pilot.mjs",
    "worker": "uv run --project worker monorail-worker",
    "worker:test": "uv run --project worker --extra vertex pytest worker/tests",
    "team:echo": "uv run --project worker monorail-worker echo"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.9",
    "@malloydata/db-bigquery": "^0.0.438",
    "@malloydata/malloy": "^0.0.438",
    "@xyflow/react": "^13.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^18.0.10",
    "fast-json-patch": "^3.1.1",
    "hono": "^4.13.19",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.71.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
